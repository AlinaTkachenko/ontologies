    <!-- http://uvic.ca/hinf572/clinicue-triage#InquiryItem -->

    <owl:Class rdf:about="http://uvic.ca/hinf572/clinicue-triage#InquiryItem">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://uvic.ca/hinf572/clinicue-triage#InquiryItem"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://uvic.ca/hinf572/clinicue-triage#hasSensitivityTier"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</xsd:maxInclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment>SafeTraumaInformedInquiryItem ≡ InquiryItem ⊓ ∃hasSensitivityTier.(≤ 2)</rdfs:comment>
    </owl:Class>
    


