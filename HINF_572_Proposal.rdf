    <!-- http://uvic.ca/hinf572/clinicue-triage#EarlyTreatmentFailureContext -->

    <owl:Class rdf:about="http://uvic.ca/hinf572/clinicue-triage#EarlyTreatmentFailureContext">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://uvic.ca/hinf572/clinicue-triage#Patient"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://uvic.ca/hinf572/clinicue-triage#undergoesTreatment"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://uvic.ca/hinf572/clinicue-triage#TreatmentEpisode"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://uvic.ca/hinf572/clinicue-triage#hasAdherence"/>
                                        <owl:someValuesFrom rdf:resource="http://uvic.ca/hinf572/clinicue-triage#ConfirmedAdherent"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://uvic.ca/hinf572/clinicue-triage#hasClinicalOutcome"/>
                                        <owl:someValuesFrom rdf:resource="http://uvic.ca/hinf572/clinicue-triage#InadequateResponse"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://uvic.ca/hinf572/clinicue-triage#prescribesMedication"/>
                                        <owl:someValuesFrom rdf:resource="http://uvic.ca/hinf572/clinicue-triage#SSRI"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://uvic.ca/hinf572/clinicue-triage#hasDurationWeeks"/>
                                        <owl:someValuesFrom>
                                            <rdfs:Datatype>
                                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                                                <owl:withRestrictions rdf:parseType="Collection">
                                                    <rdf:Description>
                                                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</xsd:minInclusive>
                                                    </rdf:Description>
                                                </owl:withRestrictions>
                                            </rdfs:Datatype>
                                        </owl:someValuesFrom>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://uvic.ca/hinf572/clinicue-triage#Patient"/>
    </owl:Class>
    


    <!-- http://uvic.ca/hinf572/clinicue-triage#HP_0002360_ReducedSleepNeed -->

