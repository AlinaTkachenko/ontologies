    <!-- http://uvic.ca/hinf572/clinicue-triage#hasSensitivityTier -->

    <owl:DatatypeProperty rdf:about="http://uvic.ca/hinf572/clinicue-triage#hasSensitivityTier">
        <rdfs:domain rdf:resource="http://uvic.ca/hinf572/clinicue-triage#InquiryItem"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>EarlyTreatmentFailureContext ≡ 
Patient 
  ⊓ ∃ undergoesTreatment.(TreatmentEpisode
  ⊓ ∃ prescribesMedication.SSRI 
  ⊓ ∃ hasClinicalOutcome.InadequateResponse 
  ⊓ ∃ hasAdherence.ConfirmedAdherent 
  ⊓ ∃ hasDurationWeeks.(≥ 4))</rdfs:comment>
    </owl:DatatypeProperty>
    


